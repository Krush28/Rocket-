# Backend
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
# Optional: install faster-whisper and set model size (tiny/base/small/medium)
WHISPER_MODEL=small

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Database (SQLite by default; use postgresql+psycopg://... for PostgreSQL)
DATABASE_URL=sqlite:///./krishi_x.db
