# Copy to .env (gitignored). docker compose reads it for the backend. Never commit real keys.

# --- Backend ---
# docker compose sets DATABASE_URL itself; set it only when running the backend outside Docker.
# DATABASE_URL=postgresql+psycopg://krishix:krishix@localhost:5432/krishix
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MIN=60
# Required to use /api/admin/import and /api/admin/refresh (unset = admin API disabled). Use a long random value.
ADMIN_TOKEN=
# Free key from data.gov.in (My Account). Needed for API pulls and the history backfill; CSV import works without it.
DATA_GOV_API_KEY=
# Geocoder (OpenStreetMap Nominatim by default; 1 request/second policy is enforced in code).
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
# AI brain that understands free speech (numbers never come from the LLM; Python does all money maths).
#   gemini = free Google Gemini cloud model (works on a weak PC; the farmer's sentence is sent to Google, the UI shows "Cloud AI")
#   ollama = local model on this machine (private, needs a GPU)      auto = cloud first, local if the cloud fails      unset = rules only
# Free key: https://aistudio.google.com/apikey  (never commit it)
# KRISHIMITRA_LLM=auto
# GEMINI_API_KEY=
# GEMINI_MODELS=gemini-flash-lite-latest,gemini-flash-latest
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.1
# Optional offline speech-to-text: pip install faster-whisper, then pick a model size (tiny/base/small/medium).
WHISPER_MODEL=small

# --- Web ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
